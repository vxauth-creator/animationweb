# =============================================================================
# NishantWebLab — Environment template
# Copy to `.env.local` and fill in. Never commit real secrets.
# Validated at runtime by `src/lib/utils/env.ts` (Zod).
# =============================================================================

# Public site URL (used for SEO / OG / sitemap). No trailing slash.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ---- Supabase (deferred — wire up in Phase 4) -------------------------------
# Public client (browser-safe).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only. NEVER expose. Used by route handlers / edge functions.
SUPABASE_SERVICE_ROLE_KEY=

# ---- Analytics / observability (optional) ----------------------------------
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=
SENTRY_DSN=

# ---- Feature flags ----------------------------------------------------------
NEXT_PUBLIC_ENABLE_EXPERIMENTAL_3D=true
